<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Title>Azunt.AttachmentManagement</Title>
    <Description>Reusable .NET attachment metadata CRUD module for general business applications. Supports EF Core In-Memory, SQL Server, Dapper, ADO.NET, safe schema enhancement, related-record metadata, and Open XML Excel export.</Description>
    <PackageTags>Azunt;attachment;file;investigation;employee;vendor;EFCore;InMemory;Dapper;ADO.NET;Blazor;SQLServer;OpenXML</PackageTags>
    <Authors>VisualAcademy</Authors>
    <Company>Hawaso</Company>
    <PackageProjectUrl>https://github.com/VisualAcademy/Azunt.AttachmentManagement</PackageProjectUrl>
    <RepositoryUrl>https://github.com/VisualAcademy/Azunt.AttachmentManagement</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright © 2026 VisualAcademy</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
